<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <title>Trang cá nhân | PRINTORY</title>
        <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@500;800&family=Denk+One&family=Kanit:wght@600;700&display=swap" rel="stylesheet">
        <!-- Font Awesome 4.7 -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
        <style>
            :root{
                --bg:#053046;
                --dark:#032636;
                --blue:#249dbc;
                --orange:#fa8501;
                --white:#ffffff;
                --gray:#d9d9d9;
            }
            *{margin:0;padding:0;box-sizing:border-box}
            body{
                background:#f4f6f8;
                font-family:'Baloo Thambi 2', cursive;
            }

            /* CHAT FLOAT */
            .chat-toggle{
                position:fixed;
                right:25px;
                bottom:25px;
                width:60px;
                height:60px;
                background:#fa8501;
                border-radius:50%;
                display:flex;
                justify-content:center;
                align-items:center;
                font-size:28px;
                color:#fff;
                cursor:pointer;
                animation:pulse 1.6s infinite;
                box-shadow:0 0 0 rgba(255, 191, 0, 0.6);
                z-index:9999;
            }

            @keyframes pulse{
                0%{box-shadow:0 0 0 0 rgba(0,132,255,.6)}
                70%{box-shadow:0 0 0 20px rgba(0,132,255,0)}
                100%{box-shadow:0 0 0 0 rgba(0,132,255,0)}
            }

            /* CHAT BOX */
            .chat-box{
                position:fixed;
                right:25px;
                bottom:100px;
                width:320px;
                height:420px;
                background:#fff;
                border-radius:20px;
                display:none;
                flex-direction:column;
                box-shadow:0 20px 40px rgba(0,0,0,.25);
                z-index:9999;
            }

            .chat-header{
                background:#fa8501;
                color:#fff;
                padding:14px;
                font-weight:800;
                display:flex;
                justify-content:space-between;
                border-radius:20px 20px 0 0;
                cursor: pointer;
            }

             
            .chat-body{
                flex:1;
                padding:15px;
                display:flex;
                flex-direction:column;
                gap:10px;
                overflow-y:auto;
                background:#f7f7f7;
            }

            .chat-msg{
                max-width:75%;
                padding:10px 14px;
                border-radius:18px;
                font-size:14px;
            }

            .chat-input{
                display:flex;
                padding:12px;
                gap:10px;
            }

            .chat-input input{
                flex:1;
                padding:10px;
                border-radius:20px;
                border:1px solid #ddd;
            }

            .chat-input button{
                width:40px;
                height:40px;
                border-radius:50%;
                border:none;
                background-color:#fa8501;
                color:#fff;
                cursor:pointer;
            }


            /* HEADER */
            header{
                background:var(--bg);
                color:#fff;
                padding:20px 60px;
                display:flex;
                justify-content:space-between;
                align-items:center;
            }
            .logo{
                font-family:'Denk One', sans-serif;
                font-size:32px;
            }
            .logo span{color:var(--orange)}
            .user-info span{font-weight:800;color:var(--orange)}

            /* LAYOUT */
            .container{
                display:grid;
                grid-template-columns: 280px 1fr 280px;
                padding:40px 60px;
                gap:30px;
            }

            /* SIDEBAR */
            .sidebar{
                width:280px;
                background:#fff;
                border-radius:20px;
                padding:25px;
                box-shadow:0 10px 30px rgba(0,0,0,.1);
                text-align:center;
            }
            .right-sidebar{
                width:280px;
                height: 550px;
                background:#fff;
                border-radius:20px;
                padding:25px;
                box-shadow:0 10px 30px rgba(0,0,0,.1);
                text-align:center;
            }
            .avatar{
                margin-bottom:20px;
            }
            .avatar img{
                width:120px;
                height:120px;
                border-radius:50%;
                object-fit:cover;
                border:4px solid var(--blue);
            }
            .avatar label{
                display:inline-block;
                margin-top:10px;
                font-size:14px;
                color:var(--blue);
                cursor:pointer;
                font-weight:800;
            }
            .avatar input{display:none}

            .sidebar h3{
                font-family:'Kanit', sans-serif;
                margin:20px 0;
            }

            .menu a{
                display:flex;
                align-items:center;
                gap:10px;
                padding:12px 16px;
                border-radius:12px;
                margin-bottom:10px;
                text-decoration:none;
                color:#333;
                cursor:pointer;
                transition:.25s;
            }
            .menu a:hover,
            .menu a.active{
                background:var(--blue);
                color:#fff;
                transform:translateX(6px);
            }
            .menu .danger{
                background:#ffecec;
                color:#ff0000;
                font-weight:800;
            }

            /* CONTENT */
            .content{
                flex:1;
                max-width: 600px;
                background:#fff;
                border-radius:20px;
                padding:30px;
                box-shadow:0 10px 30px rgba(0,0,0,.1);
            }
            .section{display:none}
            .section.active{display:block}
            .section h2{
                font-family:'Kanit', sans-serif;
                margin-bottom:20px;
                display:flex;
                align-items:center;
                gap:10px;
            }

            /* PROFILE */
            .profile-list p{margin-bottom:12px}
            .rank{
                background:linear-gradient(135deg,#fa8501,#ffb347);
                color:#fff;
                padding:6px 14px;
                border-radius:20px;
                font-weight:800;
            }

            /* FORM */
            label{display:block;margin:12px 0 6px}
            input{
                width:100%;
                padding:12px;
                border-radius:10px;
                border:2px solid var(--gray);
            }
            button{
                margin-top:20px;
                width:100%;
                padding:12px;
                border:none;
                border-radius:25px;
                background:var(--orange);
                color:#fff;
                font-size:16px;
                cursor:pointer;
                box-shadow:0 6px 0 #c76400;
            }

            .chat-input button{
                width:40px;
                height:40px;
                margin-top:0;
                padding:0;
                background:#fa8501;
                box-shadow:none;
                border-radius:50%;
                font-size:18px;
            }

            button:active{
                transform:translateY(4px);
                box-shadow:0 2px 0 #c76400;
            }

            /* ORDER */
            .order{
                border:2px solid var(--gray);
                border-radius:15px;
                padding:15px;
                width: 250px;
            }
            .order-header{
                display:flex;
                justify-content:space-between;
                cursor:pointer;
            }
            .order-detail{
                display:none;
                margin-top:15px;
                background:#f9f9f9;
                padding:15px;
                border-radius:10px;
            }

            /* FOOTER */
            footer{
                margin-top:40px;
                background:var(--dark);
                color:#fff;
                text-align:center;
                padding:15px;
                font-family:'Times New Roman', serif;
            }
            .section.active{
                display:grid;
                justify-items:center;   /* căn giữa theo chiều ngang */
            }

            /* lưới hiển thị thông tin */
            .profile-list{
                display:grid;
                grid-template-columns: repeat(1, auto); /* 2 cột gọn gàng */
                gap:16px 40px;
                margin-top:20px;
            }

            /* mỗi dòng thông tin */
            .profile-list p{
                margin:0;
                font-size:16px;
            }

            /*quảg cáo*/
            .right-sidebar .ads {
                width: 100%;
                padding-top: 100%; /* chiều cao = 40% chiều rộng */
                position: relative;
                overflow: hidden;
                border-radius: 15px;
            }

            .right-sidebar .ads img {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            /*Sản phẩm quảng cáo*/
            .product-container{
                margin-top: 15px;
            }
            .product {
                display: flex;             /* ảnh + thông tin ngang */
                align-items: center;       /* căn giữa theo chiều dọc */
                gap: 12px;
                padding: 12px;
                border: 1px solid #ddd;
                border-radius: 12px;
                background: #fff;
                width: 100%;
                max-width: 300px;          /* hoặc tuỳ container */
                box-shadow: 0 4px 10px rgba(0,0,0,0.05);
                margin-top: 5px;
            }

            .product-image img {
                width: 60px;
                height: 90px;
                object-fit: cover;
                border-radius: 8px;
            }

            .product-info {
                display: flex;
                flex-direction: column;   /* xếp tên + giá + nút thành 1 cột */
                gap: 6px;
                text-align: left;
            }

            .product-name {
                font-size: 14px;
                font-weight: 600;
                color: #053046;
            }

            .product-price {
                font-size: 13px;
                font-weight: 700;
                color: #fa8501;
            }

            .buy-btn {
                margin-top: 0;
                padding: 6px;
                font-size: 12px;
                border-radius: 20px;
                border: none;
                background: #fa8501;
                color: #fff;
                cursor: pointer;
                align-self: flex-start; /* nút canh trái cột */
                box-shadow: 0 2px 0 #c76400;
            }

            .buy-btn:active {
                transform: translateY(1px);
                box-shadow: 0 1px 0 #c76400;
            }


        </style>
    </head>

    <body>
        <header>
            <div class="logo">PRIN<span>TORY</span></div>
            <div class="user-info">Xin chào, <span>Nguyễn Quỳnh Giang</span></div>
        </header>

        <div class="container">
            <!-- SIDEBAR -->
            <aside class="sidebar">

                <!-- AVATAR -->
                <div class="avatar">
                    <img id="avatarPreview" alt="Avatar">
                    <label>
                        📷 Đổi ảnh đại diện
                        <input type="file" accept="image/*" onchange="previewAvatar(event)">
                    </label>
                </div>

                <h3>Tài khoản</h3>
                <div class="menu">
                    <a class="active" onclick="showSection('profile',this)">👤 Thông tin cá nhân</a>
                    <a onclick="showSection('update',this)">✏️ Cập nhật thông tin</a>
                    <a onclick="showSection('orders',this)">📦 Đơn đặt hàng</a>
                    <a onclick="showSection('auth',this)">🔑 Đổi mật khẩu</a>
                    <a class="danger">⏻ Đăng xuất</a>
                </div>
            </aside>

            <!-- CONTENT -->
            <main class="content">
                <div id="profile" class="section active">
                    <h2>👤 Thông tin tài khoản</h2>
                    <div class="profile-list">
                        <p><strong>Họ tên:</strong> Nguyễn Quỳnh Giang</p>
                        <p><strong>SĐT:</strong> 0373 753 621</p>
                        <p><strong>Email:</strong> nguyenquynhgiang3003@gmail.com</p>
                        <p><strong>Địa chỉ:</strong> Thủ Đức - TP.HCM</p>
                        <p><strong>Xếp hạng:</strong> <span class="rank">VIP POD</span></p>
                    </div>
                </div>

                <div id="update" class="section">
                    <h2>✏️ Cập nhật thông tin</h2>
                    <label>Họ tên</label>
                    <input type="text">

                    <label>Số điện thoại</label>
                    <input type="text">

                    <label>Email</label>
                    <input type="email">

                    <label>Địa chỉ</label>
                    <input type="text">

                    <button>Lưu thay đổi</button>
                </div>

                <div id="orders" class="section">
                    <h2>📦 Đơn đặt hàng</h2>
                    <div class="order">
                        <div class="order-header" onclick="toggleOrder(this)">
                            <span>Đơn #POD001</span>
                            <strong>Xem chi tiết</strong>
                        </div>
                        <div class="order-detail">
                            <p>Áo thun in hình – SL: 2</p>
                            <p>Giá: 200.000đ</p>
                            <p>Trạng thái: Đang xử lý</p>
                        </div>
                    </div>
                </div>

                <div id="auth" class="section">
                    <h2>🔑 Đổi mật khẩu</h2>
                    <label>Mật khẩu hiện tại</label>
                    <input type="password">
                    <label>Mật khẩu mới</label>
                    <input type="password">
                    <button>Đổi mật khẩu</button>
                </div>

                <!-- CHAT POD -->
                <div class="chat-toggle" onclick="toggleChat()">
                    <i class="fa fa-comment" aria-hidden="true"></i>
                </div>

                <div class="chat-box" id="chatBox">
                    <div class="chat-header">
                        💬 Tư vấn hỗ trợ
                        <span onclick="toggleChat()">✕</span>
                    </div>

                    <div class="chat-body"></div>

                    <div class="chat-input">
                        <input type="text" placeholder="Nhập tin nhắn...">
                        <button>➤</button>
                    </div>
                </div>

                
            </main>

            <div class="right-sidebar">
                <div class="ads">
                    <img src="pic1.png" alt="Banner quảng cáo">
                </div>

                <div class="product-container">
                    <div class="product">
                        <div class="product-image">
                            <img src="sweater.png" alt="Sản phẩm">
                        </div>
                        <div class="product-info">
                            <h3 class="product-name">Áo Thun In Hình</h3>
                            <p class="product-price">200.000₫</p>
                            <button class="buy-btn">
                                <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <div class="product">
                        <div class="product-image">
                            <img src="sweater.png" alt="Sản phẩm">
                        </div>
                        <div class="product-info">
                            <h3 class="product-name">Áo Thun In Hình</h3>
                            <p class="product-price">200.000₫</p>
                            <button class="buy-btn">
                                <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <footer>BẢN QUYỀN THUỘC VỀ PRINTORY ©</footer>

        <!--Boxchat hỗ trợ-->
        <script>
            function toggleChat(){
                const box = document.getElementById('chatBox');
                box.style.display = box.style.display === 'flex' ? 'none' : 'flex';
            }

            const chatBody = document.querySelector('.chat-body');
            const chatInput = document.querySelector('.chat-input input');
            const chatBtn = document.querySelector('.chat-input button');

            function addMsg(text, from){
                const m = document.createElement('div');
                m.className = 'chat-msg';
                m.style.background = from==='user' ? '#0084ff' : '#e4e6eb';
                m.style.color = from==='user' ? '#fff' : '#000';
                m.style.alignSelf = from==='user' ? 'flex-end' : 'flex-start';
                m.innerText = text;
                chatBody.appendChild(m);
                chatBody.scrollTop = chatBody.scrollHeight;
            }

            function botReply(msg){
                setTimeout(()=>{
                    let rep = "Dạ bạn đợi Printory chút nha, chúng mình sẽ cho nhân viên hỗ trợ ngay ạ!";
                    if(/giá/i.test(msg)) rep= "💰Các sản phẩm của Printory có giá tuỳ theo thiết kế và số lượng, cho chúng mình biết rõ hơn yêu cầu của bạn nha!";
                    if(/ship|giao/i.test(msg)) rep="Giao hàng toàn quốc từ 7-15 ngày, bao gồm cả thời gian in ấn ạ 🚚";
                    addMsg(rep,'bot');
                },900);
            }

            chatBtn.onclick = ()=>{
                if(!chatInput.value) return;
                addMsg(chatInput.value,'user');
                botReply(chatInput.value);
                chatInput.value='';
            };

            chatInput.addEventListener('keypress',e=>{
                if(e.key==='Enter') chatBtn.click();
            });

            setTimeout(()=>{
                addMsg("👋 Xin chào! Bạn cần hỗ trợ gì ạ?",'bot');
            },1000);
        </script>
        <!--Avatar-->
        <script>
            function showSection(id,el){
                document.querySelectorAll('.menu a').forEach(a=>a.classList.remove('active'));
                el.classList.add('active');
                document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
                document.getElementById(id).classList.add('active');
            }

            function toggleOrder(el){
                const d = el.nextElementSibling;
                d.style.display = d.style.display === 'block' ? 'none' : 'block';
            }

            /* ===== AVATAR AUTO SAVE ===== */
            function previewAvatar(e){
                const file = e.target.files[0];
                if(!file) return;

                const reader = new FileReader();
                reader.onload = () => {
                    const imgData = reader.result;
                    document.getElementById('avatarPreview').src = imgData;
                    localStorage.setItem('printory_avatar', imgData);
                }
                reader.readAsDataURL(file);
            }

            /* ===== LOAD AVATAR WHEN PAGE LOAD ===== */
            window.onload = () => {
                const savedAvatar = localStorage.getItem('printory_avatar');
                document.getElementById('avatarPreview').src =
                    savedAvatar ? savedAvatar : "https://i.imgur.com/0y0y0y0.png";
            }
        </script>
    </body>
</html>
